# Copy to .env and fill in values before running any tasks.
# .env is gitignored — never commit it.

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_PROFILE=default

# ── Control plane (coder-demo-eks) ─────────────────────────────────────────────
# The control-plane Coder URL this provisioner registers against.
# CODER_ACCESS_URL there is an internal NLB hostname — only resolves once the
# VPC peering + security group rule in terraform/cluster/peering.tf are live.
CODER_URL=

# Provisioner key minted by the platform team on the control plane
# (coder-demo-eks/scripts/tools/create_provisioner_key.sh). Never share this
# beyond the team it was issued to — it's scoped via its tag to which
# templates route here, but it is still a real credential.
CODER_PROVISIONER_KEY=

# ── Auto-populated by `task cluster` — leave blank, do not edit manually ──────
TEAM_CLUSTER_NAME=
