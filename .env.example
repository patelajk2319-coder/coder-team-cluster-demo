# Copy to .env and fill in values before running any tasks.
# .env is gitignored — never commit it.

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_PROFILE=default

# ── Control plane prerequisites ─────────────────────────────────────────────────
# Everything here describes whatever Coder control plane you're pairing this
# cluster with — ask its platform team for these values.

# Path to its core-infra Terraform state file (read for the VPC peering in
# terraform/cluster/peering.tf). A local path assumes that repo is checked
# out on this machine; a real cross-team setup would use a remote backend.
PLATFORM_STATE_PATH=

# AWS region it runs in.
PLATFORM_REGION=

# Name tag of its VPC — its route tables are tagged <name>-public/-private.
PLATFORM_VPC_NAME=

# Name of its EKS cluster — tags the NLB security group its ALB controller
# manages.
PLATFORM_CLUSTER_NAME=

# Its Coder URL — an internal NLB hostname, only resolves once the VPC
# peering + security group rule above are live.
CODER_URL=

# Provisioner key minted by its platform team, scoped via tag to which
# templates route here. Never share this beyond the team it was issued to.
CODER_PROVISIONER_KEY=

# ── Auto-populated by `task cluster` — leave blank, do not edit manually ──────
TEAM_CLUSTER_NAME=
